# Normalize line endings in the repository so a Windows checkout does not
# rewrite sources to CRLF. Ruff tolerates CRLF (line-ending = "auto"), but the
# repository keeps one canonical form.
* text=auto eol=lf

# Tracked candidate artifacts retain their generated LF bytes on every platform.
/compass/skills/compass/compass_runtime/web/react.html text eol=lf
/compass/skills/compass/compass_runtime/web/react.integrity.json text eol=lf
/compass/skills/compass/compass_runtime/web/react-licenses.txt text eol=lf
