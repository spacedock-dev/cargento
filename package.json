{
  "name": "cargento-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "node frontend/dev/supervisor.mjs",
    "dev:preview": "vite --config frontend/vite.config.mts",
    "build": "node frontend/build/package.mjs",
    "preview": "vite preview --config frontend/vite.config.mts",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test frontend/build/package.test.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "build:preview": "vite build --config frontend/vite.config.mts",
    "build:check": "node frontend/build/package.mjs --check",
    "test:build": "node --test frontend/build/package.test.mjs",
    "test:parser": "node --test frontend/e2e/parser.test.mjs",
    "test:installed": "node frontend/e2e/installed.mjs",
    "test:storage:browser": "node frontend/e2e/storage-conformance.mjs",
    "test:dev": "node --test --test-concurrency=1 frontend/dev/*.test.mjs",
    "test:dev:browser": "node frontend/e2e/development.mjs",
    "test:shell:browser": "node frontend/e2e/shell-routing.mjs",
    "test:controls:browser": "node frontend/e2e/controls-continuity.mjs",
    "test:sessions:browser": "node frontend/e2e/sessions-parity.mjs",
    "test:intent:browser": "node frontend/e2e/intent-parity.mjs",
    "test:drift:browser": "node frontend/e2e/drift-parity.mjs",
    "test:console:browser": "node frontend/e2e/console-parity.mjs",
    "test:project:browser": "node frontend/e2e/project-parity.mjs",
    "test:attention:browser": "node frontend/e2e/attention-parity.mjs",
    "test:capacity:browser": "node frontend/e2e/capacity-parity.mjs",
    "test:terminal:browser": "node frontend/e2e/terminal-parity.mjs && node frontend/e2e/timeline-filter.mjs",
    "test:production:browser": "node frontend/e2e/production-proofs.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
